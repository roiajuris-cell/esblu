# GOOGLE PLAY RELEASE PRÍPRAVA — šablóna pre release signing.
#
# Toto je iba PRÍKLAD/TEMPLATE bez skutočných hesiel — bezpečne trackovaný
# v Gite. Skutočný súbor sa volá presne "keystore.properties" (bez
# ".example"), leží v TOM ISTOM adresári (mobile/android/app/) a je
# natvrdo v mobile/android/.gitignore (nikdy sa nesmie commitnúť).
#
# Postup vytvorenia release keystore: pozri
# mobile/android/RELEASE_SIGNING.md
#
# storeFile — cesta ku .jks/.keystore súboru. Odporúčané: uložiť keystore
# MIMO tohto repozitára (napr. bezpečný priečinok mimo C:\Users\roiaj\assetpilot)
# a sem napísať ABSOLÚTNU cestu. Ak ho napriek tomu uložíš priamo do
# mobile/android/app/ (relatívna cesta), .gitignore ("*.jks"/"*.keystore")
# ho už chráni pred commitnutím — ale mimo-repo umiestnenie je bezpečnejšie
# (žiadne riziko ani pri budúcej zmene .gitignore).
storeFile=/absolutna/cesta/k/esblu-release.jks

# Heslo ku keystore (storePassword) — heslo zadané pri `keytool -genkeypair`.
storePassword=REPLACE_ME

# Alias kľúča v keystore (napr. "esblu") — presne to, čo bolo zadané pri
# `keytool -genkeypair -alias ...`.
keyAlias=esblu

# Heslo ku konkrétnemu kľúču (keyPassword) — pri jednoduchom -genkeypair
# postupe zvyčajne rovnaké ako storePassword, ale over podľa toho, čo si
# skutočne zadal(a).
keyPassword=REPLACE_ME
